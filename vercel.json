{
  "functions": { "api/pdf.js": { "maxDuration": 60, "includeFiles": "node_modules/@sparticuz/chromium/**" } },
  "crons": [{ "path": "/api/cron", "schedule": "0 11 * * 1-5" }],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Content-Type-Options", "value": "nosniff" } ] }
  ]
}
